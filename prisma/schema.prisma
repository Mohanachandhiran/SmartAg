datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FARMER
  FPO
  BUYER
  GOVERNMENT
}

enum ListingStatus {
  PENDING
  GROUPED
  PUBLISHED
  SOLD
}

enum BidStatus {
  ACTIVE
  ACCEPTED
  REJECTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  role      Role
  language  String   @default("en")
  location  String?  // District name, e.g. "Madurai"
  createdAt DateTime @default(now())

  // Relations
  farms             Farm[]
  cropListings      CropListing[]      @relation("FarmerListings")
  fpoListings       CropListing[]      @relation("FpoListings")
  fpoGroups         FarmerGroup[]      @relation("FpoGroups")
  groupMemberships  GroupMember[]
  bids              Bid[]
  farmerPayments    Transaction[]      @relation("FarmerTransactions")
  fpoPayments       Transaction[]      @relation("FpoTransactions")
  buyerPayments     Transaction[]      @relation("BuyerTransactions")
  notifications     Notification[]
}

model Farm {
  id           String        @id @default(uuid())
  farmerId     String
  farmer       User          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropType     String
  quantity     Float         // in kg
  qualityGrade String        // A, B, C
  harvestDate  DateTime
  gpsLat       Float
  gpsLng       Float
  status       String        @default("REGISTERED")
  createdAt    DateTime      @default(now())

  // Relations
  cropListings     CropListing[]
  groupMemberships GroupMember[]
  recommendations  AIRecommendation[]
}

model CropListing {
  id         String        @id @default(uuid())
  farmId     String
  farm       Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmerId   String
  farmer     User          @relation("FarmerListings", fields: [farmerId], references: [id], onDelete: Cascade)
  fpoId      String?
  fpo        User?         @relation("FpoListings", fields: [fpoId], references: [id], onDelete: SetNull)
  quantity   Float
  grade      String
  pickupDate DateTime?
  status     ListingStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  // Relations
  bids Bid[]
}

model FarmerGroup {
  id             String        @id @default(uuid())
  fpoId          String
  fpo            User          @relation("FpoGroups", fields: [fpoId], references: [id], onDelete: Cascade)
  groupName      String
  cropType       String
  totalQuantity  Float
  collectionDate DateTime
  route          String?       // JSON string of coordinates or route details
  status         String        @default("PENDING") // PENDING, ACTIVE, COMPLETED, etc.
  createdAt      DateTime      @default(now())

  // Relations
  members GroupMember[]
}

model GroupMember {
  id        String      @id @default(uuid())
  groupId   String
  group     FarmerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  farmId    String
  farm      Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmerId  String
  farmer    User        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  quantity  Float
  createdAt DateTime    @default(now())
}

model Bid {
  id         String      @id @default(uuid())
  listingId  String
  listing    CropListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  pricePerKg Float
  quantity   Float
  pickupDate DateTime
  status     BidStatus   @default(ACTIVE)
  createdAt  DateTime    @default(now())
}

model Transaction {
  id        String            @id @default(uuid())
  farmerId  String
  farmer    User              @relation("FarmerTransactions", fields: [farmerId], references: [id])
  fpoId     String?
  fpo       User?             @relation("FpoTransactions", fields: [fpoId], references: [id])
  buyerId   String
  buyer     User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  amount    Float
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())
}

model MarketPrice {
  id        String   @id @default(uuid())
  mandiName String
  crop      String
  price     Float    // in Rs per kg
  date      DateTime
  district  String
  state     String
}

model WeatherAlert {
  id         String   @id @default(uuid())
  district   String
  alertType  String
  severity   String   // Low, Medium, High
  message    String
  validUntil DateTime
}

model AIRecommendation {
  id                String   @id @default(uuid())
  farmId            String
  farm              Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sellToday         Float
  sellLater         Float
  joinFPO           Float
  recommendedAction String
  confidence        Float
  risk              String   // Low, Medium, High
  explanation       String
  createdAt         DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // WEATHER_ALERT, PRICE_ALERT, BID_RECEIVED, GROUP_APPROVED, PAYMENT_RECEIVED
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
